{
    "version":  "2.0.0",
    "tasks":  [
                  {
                      "label":  "build (GCC)",
                      "type":  "shell",
                      "command":  "mingw32-make",
                      "args":  [
                                   "-j8"
                               ],
                      "options":  {
                                      "cwd":  "${workspaceFolder}",
                                      "env":  {
                                                  "Path":  "D:\\app\\MinGW\\bin;D:\\arm\\GNU Toolchain mingw-w64-x86_64-arm-none-eabi\\bin;D:\\TI\\sysconfig_1.24.1;D:\\app\\Jlink;${env:Path}"
                                              }
                                  },
                      "group":  {
                                    "kind":  "build",
                                    "isDefault":  true
                                },
                      "problemMatcher":  [
                                             "$gcc"
                                         ]
                  },
                  {
                      "label":  "clean (GCC)",
                      "type":  "shell",
                      "command":  "mingw32-make",
                      "args":  [
                                   "clean"
                               ],
                      "options":  {
                                      "cwd":  "${workspaceFolder}",
                                      "env":  {
                                                  "Path":  "D:\\app\\MinGW\\bin;${env:Path}"
                                              }
                                  },
                      "problemMatcher":  [

                                         ]
                  },
