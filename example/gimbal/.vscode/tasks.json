                      "args":  [
                                   "syscfg"
                               ],
                      "options":  {
                                      "cwd":  "${workspaceFolder}",
                                      "env":  {
                                                  "Path":  "D:\\TI\\sysconfig_1.24.1;D:\\app\\MinGW\\bin;${env:Path}"
                                              }
                                  },
                      "problemMatcher":  [

                                         ]
                  },
                  {
                      "label":  "syscfg-gui",
                      "type":  "shell",
                      "command":  "D:\\TI\\sysconfig_1.24.1\\sysconfig_gui.bat",
                      "args":  [
                                   "--product",
                                   "D:/TI/mspm0_sdk_2_05_01_00/.metadata/product.json",
                                   "--compiler",
                                   "gcc",
                                   "--output",
                                   "${workspaceFolder}",
