                  {
                      "label":  "flash (GCC)",
                      "type":  "shell",
                      "command":  "mingw32-make",
                      "args":  [
                                   "flash"
                               ],
                      "options":  {
                                      "cwd":  "${workspaceFolder}",
                                      "env":  {
                                                  "Path":  "D:\\app\\MinGW\\bin;D:\\arm\\GNU Toolchain mingw-w64-x86_64-arm-none-eabi\\bin;D:\\app\\Jlink;${env:Path}"
                                              }
                                  },
                      "problemMatcher":  [

