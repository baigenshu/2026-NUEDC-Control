$(error GCC_PATH is empty. Set mspm0.gccPath in VS Code (extension injects it) or create toolpaths.mk via 同步配置)
endif
ifeq ($(strip $(SDK)),)
$(error SDK is empty. Set mspm0.sdkPath or create toolpaths.mk via 同步配置)
